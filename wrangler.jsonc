// Cloudflare Worker that serves the built site (dist/) and the multiplayer API.
// Static files are served directly; only /api/* runs Worker code.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flag-atlas",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomObject" }]
  },
  // SQLite-backed Durable Objects are the class type available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject"] }],
  "observability": { "enabled": true }
}
